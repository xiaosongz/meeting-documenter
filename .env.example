# Meeting Documenter — trusted shell configuration template
# Copy to .env, edit locally, and chmod 600 .env. .env is gitignored.
# Do not paste keys into chat or logs. Never commit the populated file.
# scripts/transcribe.sh reads only the selected config, not ~/.env implicitly.
# To select an external config, export MEETING_DOCUMENTER_ENV_FILE in your shell;
# do not put that selector inside the file it points to. Empty disables loading.

# Notes root — the agent resolves default output paths beneath this directory.
VAULT_PATH="/path/to/your/vault"

# Default transcription backend: AssemblyAI (universal-3-5-pro)
# Get a key from your AssemblyAI account and replace the placeholder locally.
ASSEMBLYAI_API_KEY="your-assemblyai-key-here"

# Optional Gemini backend: pass --backend gemini (default gemini-2.5-flash).
# Get a key at https://aistudio.google.com/apikey.
# GEMINI_API_KEY is accepted as an alternative to GOOGLE_API_KEY.
# GOOGLE_API_KEY="your-google-key-here"

# Existing-transcript processing needs no transcription API key.
# Values are shell syntax; quote paths with spaces. Source only trusted files.

# Optional layout overrides
# MEETING_NOTES_DIR="${VAULT_PATH}/MeetingNotes"
# MEETING_RAW_DIR="${MEETING_NOTES_DIR}/raw"
# MEETING_RECORDINGS_DIR="${MEETING_NOTES_DIR}/recordings"
# DAILY_NOTES_DIR="${VAULT_PATH}/DailyNotes"
# PROJECTS_DIR="${VAULT_PATH}/Projects"
# MEETING_AUDIO_BACKUP_DIR="$HOME/audio-backups/meetings"

# Daily-note strftime path relative to DAILY_NOTES_DIR, using the meeting date
# Examples: "%Y-%m-%d.md" (flat), "Journal/%Y/%Y-%m-%d.md"
# DAILY_NOTE_PATH_FORMAT="%Y/%m-%B/%Y-%m-%d.md"

# Single relative subdir under PROJECTS_DIR/{Name}; empty means project root
# PROJECT_MEETING_SUBDIR="Meeting"

# Output link form: wikilink (Obsidian), markdown, or plain
# LINK_STYLE="wikilink"
